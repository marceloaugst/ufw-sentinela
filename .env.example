# Exemplo de configuração. Copie para /etc/ufwrelatorio.env (chmod 600, dono root)
# e preencha. NUNCA coloque o arquivo real no git.

# --- Obrigatórios ---
# Token do bot (crie com o @BotFather no Telegram)
TELEGRAM_TOKEN=123456789:COLE_O_TOKEN_AQUI
# Seu ID numérico de chat (veja com o @userinfobot). Só este chat manda comandos.
TELEGRAM_CHAT_ID=123456789

# --- Proteção contra auto-bloqueio ---
# IPs que nunca serão banidos (coloque o SEU IP). Separe por vírgula.
UFW_NUNCA_BANIR=203.0.113.10,198.51.100.20

# --- Caminhos (os padrões servem se o bot rodar na pasta do relatório) ---
#UFW_RELATORIO_BIN=/opt/ufw/relatorio/ufwrelatorio
#UFW_PENDENTES=/opt/ufw/relatorio/log/pendentes.json
#UFW_BANS=/opt/ufw/relatorio/log/bans.json
#UFW_SSH_CONHECIDOS=/opt/ufw/relatorio/log/ssh_conhecidos.json
#UFW_LOG=/var/log/ufw.log
#UFW_AUTH_LOG=/var/log/auth.log

# --- Banimento temporário (aceita 90m, 24h, 7d) ---
UFW_DURACAO_CURTA=24h
UFW_DURACAO_LONGA=7d

# --- Ban automático: mais de N tentativas na janela => ban (0 desliga) ---
UFW_AUTO_LIMITE=20
UFW_AUTO_JANELA=10m

# --- Alertas em tempo real (0 desliga pico/varredura) ---
UFW_ALERTA_PICO=100
UFW_ALERTA_PORTAS=15
UFW_ALERTA_JANELA=5m
UFW_ALERTA_PAUSA=30m
UFW_ALERTA_MAX_HORA=20
# 0 desliga o aviso de login SSH de IP novo
UFW_ALERTA_SSH=1

# --- Opcional: nota de abuso do AbuseIPDB (https://www.abuseipdb.com) ---
#ABUSEIPDB_KEY=
